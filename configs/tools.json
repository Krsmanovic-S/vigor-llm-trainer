    {
        "type": "function",
        "function": {
            "name": "createTemplate",
            "description": "Create a workout template.",
            "parameters": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Template name, for example Upper Body."
                    },
                    "exercises": {
                        "type": "string",
